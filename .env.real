# جميع الطلبات تمر عبر الـ proxy على /api/proxy/* (server-side only)
# لا حاجة لأي NEXT_PUBLIC_* لأن العنوان يبقى سرياً على الخادم.

# عنوان الباك إند الحقيقي — يستخدمه /api/proxy/* route handler فقط
BACKEND_URL=http://185.211.5.19:8081

# وضع الـ API: "real" للاتصال بالباك إند الحقيقي
NEXT_PUBLIC_API_MODE=real

# قاعدة البيانات (Prisma - SQLite محلية للتطوير)
DATABASE_URL=file:/home/z/my-project/db/custom.db
